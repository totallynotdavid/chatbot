# ENVIRONMENT
NODE_ENV=development
LOG_LEVEL=debug

# BACKEND
# Required
DB_PATH=./data/database.sqlite
# Publicly served files (catalog images). Both stores below must sit on
# persistent storage: the asset rows outlive a restart, so the bytes have to.
UPLOAD_DIR=./data/uploads
# Contracts and call recordings, which are never served statically and are
# reachable only through /api/assets/:id. Optional: defaults to a "private"
# directory beside UPLOAD_DIR, so setting UPLOAD_DIR alone is enough.
PRIVATE_DIR=./data/private
# Generate this using "bun scripts/generate-token.ts jwt"
JWT_SECRET=
# Encrypts WhatsApp credentials at rest (channel_secrets). 32 bytes, hex or
# base64. Generate with "bun scripts/generate-token.ts secrets".
# Required before a channel account can store a token.
SECRETS_KEY=
# Get this with "hostname -I" (if deployed in a local network)
# Use the domain name or public IP if deployed on the internet
PUBLIC_URL=http://localhost:5173

# NOTIFIER
# Required
NOTIFIER_DATA_PATH=./data/notifier
CHROME_PATH=

# WhatsApp
# These seed the first channel account (one tenant, one business number).
# After the first seed they are no longer read at runtime: inbound webhooks are
# routed by the phone-number id stored on the channel account, and outbound
# sends use that account's encrypted token. Add further numbers through
# POST /api/admin/channels.
# Optional
WHATSAPP_GROUP_AGENT=
WHATSAPP_GROUP_DEV=

# The number VendeYa's own operations alerts are sent from. Some events belong
# to the platform and not to any tenant - both eligibility providers being down
# is one deployment-wide outage - so they have no tenant channel account to go
# out on. Leave this unset and WHATSAPP_PHONE_ID is used, which is where those
# alerts came from before tenancy. A platform operator can override it at
# runtime with the `platform_ops_channel_account_id` platform setting.
PLATFORM_OPS_PHONE_NUMBER_ID=

# Required only in production
# 1. Create a system user: https://developers.facebook.com/documentation/business-messaging/whatsapp/solution-providers/manage-system-users/
# 2. Generate a permanent token with all whatsapp-* permissions
WHATSAPP_TOKEN=
# This is not your phone number
WHATSAPP_PHONE_ID=
# Generate this using "bun scripts/generate-token.ts webhook"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# EXTERNAL PROVIDERS
# Calidda FNB (required)
CALIDDA_BASE_URL=https://appweb.calidda.com.pe
CALIDDA_USERNAME=
CALIDDA_PASSWORD=

# Calidda Gaso (PowerBI) (required)
POWERBI_RESOURCE_KEY=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
POWERBI_MODEL_ID=

# LLM (optional)
# Vision
GEMINI_API_KEY=
# Text
OPENAI_API_KEY=

# BOOTSTRAP ACCOUNT
# The seed ships no credentials. Set these once to create the first account,
# then unset them. The password must be at least 12 characters.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
# "true" makes the first account VendeYa platform staff (acts across tenants)
# instead of an admin of the default tenant. It is also how a deployment that
# has no platform operator gains one: set it with the two variables above and
# run `bun run seed`.
BOOTSTRAP_ADMIN_PLATFORM_OPERATOR=false

# MIGRATING A PRE-TENANCY DATABASE
# Migrating promotes one existing account to platform operator, so the upgraded
# deployment can onboard its second tenant. The oldest admin is chosen unless
# this names somebody else. Only read during that one-off migration.
MIGRATION_PLATFORM_OPERATOR_USERNAME=
