# Each variable says what happens without it, as the table in
# docs/operations.md does. Boot warns when WHATSAPP_APP_SECRET is unset and
# checks no other variable.

# ENVIRONMENT
# Without it: replies go through the Cloud API, test data is seeded and cookies
# are not secure. "development" sends through the notifier. "production" skips
# the test data and sets secure cookies.
NODE_ENV=development
# Without it: info
LOG_LEVEL=debug

# BACKEND
# Without it: ./data/database.sqlite
DB_PATH=./data/database.sqlite
# Publicly served files (catalog images). Both stores below must sit on
# persistent storage: the asset rows outlive a restart, so the bytes have to.
# Without it: ./data/uploads
UPLOAD_DIR=./data/uploads
# Contracts and call recordings, which are never served statically and are
# reachable only through /api/assets/:id.
# Without it: a "private" directory beside UPLOAD_DIR, so setting UPLOAD_DIR
# alone is enough.
PRIVATE_DIR=./data/private
# Encrypts WhatsApp credentials at rest (channel_secrets). 32 bytes, hex or
# base64. Generate with "bun scripts/generate-token.ts secrets".
# Without it: no channel token can be stored or read.
SECRETS_KEY=
# The address the outside world reaches the frontend at, with the scheme. Get
# the host with "hostname -I" (if deployed in a local network). Use the domain
# name or public IP if deployed on the internet. Image links, alert links and
# the CORS origin use it. A running "bun run dev:tunnel" wins over it outside
# production.
# Without it: http://localhost:5173
PUBLIC_URL=http://localhost:5173

# NOTIFIER
# Development only. Production sends through the Cloud API and runs no notifier.
# Without it: ./data
NOTIFIER_DATA_PATH=./data/notifier
# Without it: puppeteer's Chromium
CHROME_PATH=

# WhatsApp
# WHATSAPP_TOKEN, WHATSAPP_PHONE_ID and WHATSAPP_WEBHOOK_VERIFY_TOKEN seed the
# first channel account (one tenant, one business number).
# Inbound webhooks are routed by the phone-number id stored on the channel
# account. Outbound sends use that account's encrypted token. Add further
# numbers through POST /api/admin/channels.
# Without it: sales alerts with no tenant setting have no target.
WHATSAPP_GROUP_AGENT=
# Without it: dev alerts with no tenant setting have no target.
WHATSAPP_GROUP_DEV=

# The number VendeYa's own operations alerts are sent from. Some events belong
# to the platform, not to any tenant. Both eligibility providers being down is
# one deployment-wide outage. Those alerts have no tenant channel account to go
# out on. A platform operator can override it at runtime with the
# `platform_ops_channel_account_id` platform setting.
# Without it, or when it matches no channel account: WHATSAPP_PHONE_ID's
# account.
PLATFORM_OPS_PHONE_NUMBER_ID=

# Set these three in production. Development sends through the notifier.
# Without WHATSAPP_PHONE_ID none of the three is used. Without any of them the
# default tenant's number is a `pending` placeholder that cannot send or
# receive.
# 1. Create a system user: https://developers.facebook.com/documentation/business-messaging/whatsapp/solution-providers/manage-system-users/
# 2. Generate a permanent token with all whatsapp-* permissions
WHATSAPP_TOKEN=
# This is not your phone number
WHATSAPP_PHONE_ID=
# Generate this using "bun scripts/generate-token.ts webhook"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# The Meta app secret (App Dashboard > App settings > Basic). POST /api/webhook
# accepts a request only when X-Hub-Signature-256 is `sha256=` plus the hex
# HMAC-SHA256 of its raw body under this secret. Every number shares this
# secret.
# Without it: POST /api/webhook answers 503, so no inbound message is accepted.
WHATSAPP_APP_SECRET=

# EXTERNAL PROVIDERS
# Calidda FNB. Without any of the three, every FNB eligibility check fails.
CALIDDA_BASE_URL=https://appweb.calidda.com.pe
CALIDDA_USERNAME=
CALIDDA_PASSWORD=

# Calidda Gaso (PowerBI). Without any of the four, every Gaso eligibility check
# fails.
POWERBI_RESOURCE_KEY=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
POWERBI_MODEL_ID=

# LLM
# Without it: any message the regexes miss gets no reply.
OPENAI_API_KEY=
