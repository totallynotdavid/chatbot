{
    "name": "vendeya",
    "private": "true",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "seed": "cd apps/backend && bun run seed",
        "account": "cd apps/backend && bun run account",
        "clean": "bun run clean:deps && bun run clean:sessions && bun run clean:logs",
        "clean:deps": "bun x shx rm -rf apps/*/node_modules packages/*/node_modules node_modules",
        "clean:sessions": "bun x shx rm -rf apps/notifier/data",
        "clean:logs": "bun x shx rm -rf apps/*/data/**/logs",
        "dev": "bun run --parallel --no-exit-on-error dev:backend dev:notifier dev:frontend",
        "dev:backend": "bun run --cwd apps/backend dev",
        "dev:frontend": "bun run --cwd apps/frontend dev",
        "dev:notifier": "bun run --cwd apps/notifier dev",
        "dev:tunnel": "bun run scripts/tunnel.ts start",
        "dev:tunnel:reset": "bun run scripts/tunnel.ts stop",
        "build:frontend": "cd apps/frontend && bun run build",
        "build": "bun run build:frontend",
        "format": "biome format --write",
        "format:md": "bun x prettier \"**/*.{md,yml,yaml}\" --write --print-width=80 --prose-wrap=always"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.2",
        "@vendeya/tsconfig": "workspace:*",
        "shx": "^0.4.0",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "basic-ftp": ">=5.3.1 <6.0.0",
        "brace-expansion": ">=2.1.4 <3.0.0",
        "ip-address": ">=10.3.1 <11.0.0",
        "js-yaml": ">=4.3.1 <5.0.0",
        "lodash": ">=4.17.24 <5.0.0",
        "ws": ">=8.21.0 <9.0.0"
    }
}
