{
  "name": "vendeya",
  "private": "true",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "lint": "bun run lint:js && bun run lint:fmt",
    "lint:js": "biome lint && biome format",
    "lint:fmt": "oxfmt --check '**/*.{md,yml,yaml,json}'",
    "fix": "bun run fix:js && bun run fix:fmt",
    "fix:js": "biome check --write",
    "fix:fmt": "oxfmt '**/*.{md,yml,yaml,json}'",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --timeout 60000 --path-ignore-patterns '**/*.integration.test.ts'",
    "test:integration": "bun test --timeout 60000 .integration.test.ts",
    "build": "bun run --cwd apps/frontend build",
    "db:migrate": "cd apps/backend && bun run db:migrate",
    "seed": "cd apps/backend && bun run seed",
    "account": "cd apps/backend && bun run account",
    "clean": "bun run clean:deps && bun run clean:logs",
    "clean:deps": "bun x shx rm -rf apps/*/node_modules packages/*/node_modules node_modules",
    "clean:logs": "bun x shx rm -rf apps/*/data/**/logs",
    "dev": "bun run --parallel --no-exit-on-error dev:backend dev:frontend",
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:frontend": "bun run --cwd apps/frontend dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vendeya/tsconfig": "workspace:*",
    "oxfmt": "0.75.0",
    "shx": "^0.4.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2"
  },
  "overrides": {
    "basic-ftp": ">=5.3.1 <6.0.0",
    "brace-expansion": ">=2.1.4 <3.0.0",
    "ip-address": ">=10.3.1 <11.0.0",
    "js-yaml": ">=4.3.1 <5.0.0",
    "lodash": ">=4.17.24 <5.0.0",
    "typescript": "$typescript",
    "ws": ">=8.21.0 <9.0.0"
  }
}
