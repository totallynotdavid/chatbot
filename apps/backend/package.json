{
  "name": "@vendeya/backend",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun run --env-file=../../.env src/index.ts",
    "dev": "bun run --watch --env-file=../../.env src/index.ts",
    "db:migrate": "bun run --env-file=../../.env src/db/migrate-cli.ts",
    "seed": "bun run --env-file=../../.env src/db/seed.ts",
    "account": "bun run --env-file=../../.env src/cli/account.ts",
    "clean": "bun x shx rm -f 'data/*.sqlite' 'data/*.sqlite-shm' 'data/*.sqlite-wal'",
    "typecheck": "tsc --noEmit",
    "test": "bun test --env-file=../../.env",
    "test:llm": "bun test --env-file=../../.env tests/llm-service.test.ts"
  },
  "dependencies": {
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vendeya/core": "workspace:*",
    "@vendeya/intelligence": "workspace:*",
    "@vendeya/logger": "workspace:*",
    "@vendeya/types": "workspace:*",
    "@vendeya/utils": "workspace:*",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@vendeya/tsconfig": "workspace:*"
  }
}
