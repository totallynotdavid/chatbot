{
    "name": "@vendeya/frontend",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "bun --env-file=../../.env vite dev --host",
        "build": "bun run --bun vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch"
    },
    "dependencies": {
        "@vendeya/types": "workspace:*",
        "@vendeya/utils": "workspace:*"
    },
    "devDependencies": {
        "@sveltejs/adapter-bun": "^1.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@vendeya/tsconfig": "workspace:*",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "uuid": "^14.0.2",
        "vite": "^8.3.2",
        "vite-plugin-devtools-json": "^1.1.0"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
