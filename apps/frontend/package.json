{
  "name": "@vendeya/frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env vite dev --host",
    "build": "bun run --bun vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@vendeya/types": "workspace:*",
    "@vendeya/utils": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vendeya/tsconfig": "workspace:*",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vite-plugin-devtools-json": "^1.1.2"
  }
}
