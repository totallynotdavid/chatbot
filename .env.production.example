# The env file of the production stack, kept outside the repository (for example
# /etc/vendeya/env, readable by root only). docs/deploy.md covers the stack.
#   docker compose --env-file /etc/vendeya/env -f deploy/compose.prod.yml up -d
# A value marked required stops `docker compose` by name when it is empty.
# Where a variable says "Without it", the backend's behavior is described in
# docs/operations.md.

# IMAGES
# The tag of each image under ghcr.io/totallynotdavid/chatbot. The deploy
# workflow tags an image with sha-<7 characters of the commit that built it>.
# Each image has its own tag: the workflow builds only the images a commit
# touched.
# Required.
BACKEND_TAG=
WEB_TAG=
BACKUP_TAG=
# Where the images live, without the image name. A fork sets it to
# ghcr.io/<owner>/<repository> in lower case, the path its deploy workflow
# pushes to.
# Without it: ghcr.io/totallynotdavid/chatbot
IMAGE_REPOSITORY=

# CLOUDFLARE
# The token of the tunnel that has no public hostname. A Worker reaches
# http://web:3000 through a Workers VPC service on that tunnel.
# Required.
TUNNEL_TOKEN=
# The address the outside world reaches the dashboard at, with the scheme, such
# as https://ventas.example.workers.dev. Image links, alert links and the CORS
# origin use it.
# Required.
PUBLIC_URL=

# SECRETS
# Required. Generate with "bun scripts/generate-token.ts secrets". Encrypts
# WhatsApp credentials at rest (channel_secrets). 32 bytes, hex or base64.
# Losing it makes every stored channel token unreadable.
SECRETS_KEY=
# Required. The password of the stack's Postgres.
POSTGRES_PASSWORD=

# WHATSAPP
# The Meta app secret (App Dashboard > App settings > Basic). POST /api/webhook
# accepts a request only when X-Hub-Signature-256 is `sha256=` plus the hex
# HMAC-SHA256 of its raw body under this secret.
# Required.
WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN, WHATSAPP_PHONE_ID and WHATSAPP_WEBHOOK_VERIFY_TOKEN seed the
# first channel account (one tenant, one business number). Add further numbers
# through POST /api/admin/channels.
# Without WHATSAPP_PHONE_ID none of the three is used. Without any of them the
# default tenant's number is a `pending` placeholder that cannot send or
# receive.
# 1. Create a system user: https://developers.facebook.com/documentation/business-messaging/whatsapp/solution-providers/manage-system-users/
# 2. Generate a permanent token with all whatsapp-* permissions
WHATSAPP_TOKEN=
# This is not your phone number
WHATSAPP_PHONE_ID=
# Generate this using "bun scripts/generate-token.ts webhook"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Without it: sales alerts with no tenant setting have no target.
WHATSAPP_GROUP_AGENT=
# Without it: dev alerts with no tenant setting have no target.
WHATSAPP_GROUP_DEV=
# The number VendeYa's own operations alerts are sent from.
# Without it, or when it matches no channel account: WHATSAPP_PHONE_ID's
# account.
PLATFORM_OPS_PHONE_NUMBER_ID=
# The Graph API version of every Cloud API call, like "v26.0".
# Without it: v26.0
GRAPH_API_VERSION=
# Replaces the Graph host, for a proxy or a fake server.
# Without it: https://graph.facebook.com
GRAPH_API_BASE_URL=

# EXTERNAL PROVIDERS
# Calidda FNB. Without any of the three, every FNB eligibility check fails.
CALIDDA_BASE_URL=https://appweb.calidda.com.pe
CALIDDA_USERNAME=
CALIDDA_PASSWORD=
# Calidda Gaso (PowerBI). Without any of the four, every Gaso eligibility check
# fails.
POWERBI_RESOURCE_KEY=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
POWERBI_MODEL_ID=

# LLM
# Without it: any message the regexes miss gets no reply.
OPENAI_API_KEY=

# BACKUP
# A restic repository on S3, such as s3:https://s3.us-east-1.amazonaws.com/bucket
# or s3:https://<account>.r2.cloudflarestorage.com/bucket.
# Required.
RESTIC_REPOSITORY=
# Required. Encrypts the repository. Losing it makes every backup unreadable.
RESTIC_PASSWORD=
# Required. A key that can read, write and delete in the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Without it: us-east-1. Cloudflare R2 takes "auto".
AWS_DEFAULT_REGION=
# Seconds between backups.
# Without it: 21600 (six hours).
BACKUP_INTERVAL_SECONDS=

# OPTIONAL
# Without it: info
LOG_LEVEL=
# Without it: 2300
BOT_RESPONSE_DELAY_MS=
