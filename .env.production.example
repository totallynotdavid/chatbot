# ENVIRONMENT
NODE_ENV=production
LOG_LEVEL=info

# BACKEND
# Required
DB_PATH=/var/lib/vendeya/database.sqlite
# Publicly served files (catalog images). This must be a persistent volume, not
# a path under the working directory: the working directory is replaced on every
# redeploy while the asset rows in the database survive.
UPLOAD_DIR=/var/lib/vendeya/uploads
# Contracts and call recordings, which are never served statically and are
# reachable only through /api/assets/:id. Optional: defaults to a "private"
# directory beside UPLOAD_DIR (/var/lib/vendeya/private here), so setting
# UPLOAD_DIR alone already puts it on the same volume.
PRIVATE_DIR=/var/lib/vendeya/private
# Generate this using "bun scripts/generate-token.ts jwt"
JWT_SECRET=
# Encrypts WhatsApp credentials at rest (channel_secrets). 32 bytes, hex or
# base64. Generate with "bun scripts/generate-token.ts secrets".
# Required: without it the seed cannot store WHATSAPP_TOKEN encrypted.
SECRETS_KEY=
# Get this with "hostname -I" (if deployed in a local network)
# Use the domain name or public IP if deployed on the internet
PUBLIC_URL=

# WhatsApp
# WHATSAPP_TOKEN, WHATSAPP_PHONE_ID and WHATSAPP_WEBHOOK_VERIFY_TOKEN seed the
# first channel account (one tenant, one business number).
# Inbound webhooks are routed by the phone-number id stored on the channel
# account. Outbound sends use that account's encrypted token. Add further
# numbers through POST /api/admin/channels.
# Optional
WHATSAPP_GROUP_AGENT=
WHATSAPP_GROUP_DEV=

# The number VendeYa's own operations alerts are sent from. Some events belong
# to the platform, not to any tenant. Both eligibility providers being down is
# one deployment-wide outage. Those alerts have no tenant channel account to go
# out on. When this is unset or matches no channel account, WHATSAPP_PHONE_ID is
# used. A platform operator can override it at runtime with the
# `platform_ops_channel_account_id` platform setting.
PLATFORM_OPS_PHONE_NUMBER_ID=

# Required
# 1. Create a system user: https://developers.facebook.com/documentation/business-messaging/whatsapp/solution-providers/manage-system-users/
# 2. Generate a permanent token with all whatsapp-* permissions
WHATSAPP_TOKEN=
# This is not your phone number
WHATSAPP_PHONE_ID=
# Generate this using "bun scripts/generate-token.ts webhook"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# The Meta app secret (App Dashboard > App settings > Basic). POST /api/webhook
# accepts a request only when X-Hub-Signature-256 is `sha256=` plus the hex
# HMAC-SHA256 of its raw body under this secret. Every number shares this
# secret. When it is unset, POST answers 503.
# Required
WHATSAPP_APP_SECRET=

# FRONTEND
# The frontend server refuses a request body above this size before any route
# runs. The adapter's default is 512K and Meta documents webhook payloads of up
# to 3 MB. The adapter reads K, M and G as multiples of 1024.
BODY_SIZE_LIMIT=3M

# EXTERNAL PROVIDERS
# Calidda FNB (required)
CALIDDA_BASE_URL=https://appweb.calidda.com.pe
CALIDDA_USERNAME=
CALIDDA_PASSWORD=

# Calidda Gaso (PowerBI) (required)
POWERBI_RESOURCE_KEY=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
POWERBI_MODEL_ID=

# LLM (optional)
# Vision
GEMINI_API_KEY=
# Text
OPENAI_API_KEY=
